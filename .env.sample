# =============================================================================
# Mifos X Web App - Environment Variables
# =============================================================================
#
# This file documents all available environment variables for the application.
# Copy this file to .env or .env.local and adjust the values as needed.
#
# File loading priority (highest to lowest):
#   1. .env.[mode].local  (e.g., .env.development.local)
#   2. .env.[mode]        (e.g., .env.development)
#   3. .env.local
#   4. .env
#
# Note: Files ending in .local are ignored by git and should be used for
# sensitive or machine-specific configuration.
#
# =============================================================================

# -----------------------------------------------------------------------------
# API Configuration
# -----------------------------------------------------------------------------

# Base URL for the Fineract server (protocol + host + port)
# Default: https://localhost:8443
VITE_FINERACT_API_URL=https://localhost:8443

# API path prefix (provider path)
# Default: /fineract-provider/api
VITE_FINERACT_API_PROVIDER=/fineract-provider

# API version
# Default: /v1
VITE_FINERACT_API_VERSION=/api

# -----------------------------------------------------------------------------
# Fineract Platform Configuration
# -----------------------------------------------------------------------------

# Tenant identifier for multi-tenant Fineract deployments
# This value is sent in the 'Fineract-Platform-TenantId' header
# Default: default
VITE_FINERACT_PLATFORM_TENANT_IDENTIFIER=default

# More tenants to offer on the sign-in page, comma separated
# The tenant above is always offered, and is the one selected at first
# Default: (empty)
# VITE_FINERACT_PLATFORM_TENANTS_IDENTIFIER=default,tenant2

# -----------------------------------------------------------------------------
# Copilot AI Assistant (Optional)
# -----------------------------------------------------------------------------

# Turn the Copilot on for this deployment
# Default: false
# VITE_MIFOS_ENABLE_COPILOT=false

# Base URL of the Copilot gateway (openMF/mcp-mifosx/gateway).
# 'mock' (or empty) serves recorded responses, so no gateway is needed.
# Default: mock
# VITE_MIFOS_COPILOT_MCP_BASE_URL=mock

# -----------------------------------------------------------------------------
# Application Settings (Optional)
# -----------------------------------------------------------------------------

# Application title displayed in the browser tab
# Default: Mifos X
# VITE_APP_TITLE=Mifos X

# Enable debug mode for additional logging
# Default: false
# VITE_DEBUG=false

# Sign the user out after this many milliseconds without activity in any tab.
# A warning with a 'Stay signed in' button shows shortly before. 0 turns it off.
# Default: 300000 (5 minutes)
# VITE_MIFOS_SESSION_IDLE_TIMEOUT=300000

# -----------------------------------------------------------------------------
# Feature Flags (Optional)
# -----------------------------------------------------------------------------

# Enable experimental features
# Default: false
# VITE_ENABLE_EXPERIMENTAL=false

# -----------------------------------------------------------------------------
# Examples for different environments
# -----------------------------------------------------------------------------
#
# Development (local Fineract):
#   VITE_FINERACT_API_URL=https://localhost:8443
#   VITE_FINERACT_API_PROVIDER=/fineract-provider
#   VITE_FINERACT_API_VERSION=/api
#   VITE_FINERACT_PLATFORM_TENANT_IDENTIFIER=default
#
# Staging:
#   VITE_FINERACT_API_URL=https://staging.mifos.org
#   VITE_FINERACT_API_PROVIDER=/fineract-provider
#   VITE_FINERACT_API_VERSION=/api
#   VITE_FINERACT_PLATFORM_TENANT_IDENTIFIER=staging
#
# Production:
#   VITE_FINERACT_API_URL=https://api.mifos.org
#   VITE_FINERACT_API_PROVIDER=/fineract-provider
#   VITE_FINERACT_API_VERSION=/api
#   VITE_FINERACT_PLATFORM_TENANT_IDENTIFIER=production
#
# =============================================================================
