# Local development environment (used by Vite dev server)
# Empty FINERACT_API_URL = relative URLs → requests go through Vite proxy
VITE_FINERACT_API_URL=
VITE_FINERACT_API_PROVIDER=/fineract-provider
VITE_FINERACT_API_VERSION=/api
VITE_FINERACT_PLATFORM_TENANT_IDENTIFIER=default
VITE_FINERACT_PLUGIN_OIDC_ENABLED=false

# Keep contributors signed in while they switch between the editor and the
# browser. Production and Docker builds do not read this file, so they keep
# the default idle timeout (see VITE_MIFOS_SESSION_IDLE_TIMEOUT in .env.sample).
VITE_MIFOS_SESSION_IDLE_TIMEOUT=0
