{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "target": "ES2022",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "types": ["node"],
    "outDir": "./dist-playwright",
    "rootDir": "."
  },
  "include": ["playwright/**/*.ts", "playwright.config.ts"],
  "exclude": ["node_modules", "src"]
}
