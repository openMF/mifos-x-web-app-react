# =============================================================================
# Docker Environment Variables — SAMPLE
# =============================================================================
# Copy this file to .env.docker and fill in your actual secrets.
#
#   cp .env.docker.sample .env.docker
#
# NEVER commit .env.docker to version control!
# =============================================================================

# ---------- MariaDB Root Password ----------
MYSQL_ROOT_PASSWORD=CHANGE_ME_USE_STRONG_PASSWORD

# ---------- Fineract Database Connection ----------
FINERACT_HIKARI_PASSWORD=CHANGE_ME_USE_STRONG_PASSWORD
FINERACT_DEFAULT_TENANTDB_PWD=CHANGE_ME_USE_STRONG_PASSWORD

# ---------- Zitadel OIDC Secrets (only needed if OIDC is enabled) ----------
FINERACT_PLUGIN_OIDC_SERVICE_USER_CLIENT_SECRET=CHANGE_ME
FINERACT_PLUGIN_OIDC_OPAQUETOKEN_CLIENT_SECRET=CHANGE_ME
