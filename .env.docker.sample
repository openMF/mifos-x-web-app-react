# =============================================================================
# Docker Environment Variables — SAMPLE
# =============================================================================
# Copy this file to .env.docker and fill in your actual secrets.
#
#   cp .env.docker.sample .env.docker
#
# NEVER commit .env.docker to version control!
# =============================================================================

# ---------- Database Password ----------
# NOTE: these three MUST be set to the SAME value. Fineract connects to
# PostgreSQL as the superuser created by POSTGRES_PASSWORD, both for its
# own connection pool (HIKARI) and for the default tenant database.
POSTGRES_PASSWORD=CHANGE_ME_USE_STRONG_PASSWORD
FINERACT_HIKARI_PASSWORD=CHANGE_ME_USE_STRONG_PASSWORD
FINERACT_DEFAULT_TENANTDB_PWD=CHANGE_ME_USE_STRONG_PASSWORD

# ---------- Zitadel OIDC Secrets (only needed if OIDC is enabled) ----------
FINERACT_PLUGIN_OIDC_SERVICE_USER_CLIENT_SECRET=CHANGE_ME
FINERACT_PLUGIN_OIDC_OPAQUETOKEN_CLIENT_SECRET=CHANGE_ME

# ---------- TLS certificate locations (production only) ----------
# Used by docker-compose.prod.yml. Both database connections run with
# sslmode=verify-full, so these directories must contain the certificates
# described in that file. Not needed for local development.
POSTGRES_TLS_DIR=./certs/postgres
FINERACT_TLS_DIR=./certs/fineract
